// radiant.rc — CoD4Radiant resource script
// P5.5: the real CMainFrame menu (IDR_MENU_QUAKE3) + accelerator (IDR_MAIN_ACCEL),
// reconstructed from the binary's resource table (raw/MENU/214.bin + raw/ACCELERATOR/
// 101.bin, Phase-0 extraction). Numeric command IDs are the binary's; the New/Open/
// Save/Undo/Redo items reuse MFC standard IDs (0xE100/01/03, 0xE12B/2C). Menu items
// without an ON_COMMAND handler auto-grey (CFrameWnd m_bAutoMenuEnable) — Part 2
// (porter batches) wires the command wrappers category by category.
//
// Toolbar/icon/dialog templates remain Phase 5/6 (raw/ under radiant_artifacts).

#include "resource.h"
#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

