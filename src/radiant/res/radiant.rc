// Information prompt (PE resource 0x96 = 150 = IDD_INFORMATION) — the modeless state-prompt
// window driven by ShowInfoDialog (0x40BE90) for the patch BEND and INSERT/DELETE modes.
// A single DISABLED multiline edit (id 1136) fills the client area and holds the message.
// Extracted verbatim from CoD4Radiant.exe RT_DIALOG 150: 186x95, style 0x80C00040
// (DS_SETFONT|WS_POPUP|WS_CAPTION — note NO WS_SYSMENU), control style 0x58A10004.
IDD_INFORMATION DIALOG 0, 0, 186, 95
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "Information"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_INFO_TEXT, 7, 7, 172, 81, ES_MULTILINE | WS_DISABLED | WS_VSCROLL
END

// Patch Inspector "Patch Properties" (PE resource 0xAC = 172 = IDD_PATCH_PROPERTIES), the
// CPatchDialog (g_PatchDialog / CWnd_PatchDialog).  Control IDs are the binary's.  Left half
// = DETAILS (pick a control point by Row/Column -> show X/Y/Z/S/T + Type); right half =
// TEXTURING (texture name + shift/stretch/rotate texdef + CAP/Set/Natural/Fit).  Extracted
// faithfully from the image (dlgfind.py).  Texturing/Apply/Type wiring lands in later pieces.
IDD_PATCH_PROPERTIES DIALOGEX 0, 0, 272, 178
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Patch Properties"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Details", IDC_STATIC, 7, 7, 87, 148
    LTEXT           "Row:", IDC_STATIC, 15, 17, 18, 8
    COMBOBOX        1301, 15, 29, 34, 79, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Column:", IDC_STATIC, 54, 17, 26, 8
    COMBOBOX        1302, 54, 29, 34, 84, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "X:", IDC_STATIC, 21, 51, 8, 8
    EDITTEXT        1089, 34, 49, 54, 12, ES_AUTOHSCROLL
    LTEXT           "Y:", IDC_STATIC, 21, 66, 8, 8
    EDITTEXT        1142, 33, 64, 55, 12, ES_AUTOHSCROLL
    LTEXT           "Z:", IDC_STATIC, 21, 83, 8, 8
    EDITTEXT        1147, 33, 81, 55, 12, ES_AUTOHSCROLL
    LTEXT           "S:", IDC_STATIC, 21, 100, 8, 8
    EDITTEXT        1102, 33, 98, 55, 12, ES_AUTOHSCROLL
    LTEXT           "T:", IDC_STATIC, 21, 117, 8, 8
    EDITTEXT        1106, 33, 115, 55, 12, ES_AUTOHSCROLL
    LTEXT           "Type:", IDC_STATIC, 13, 136, 19, 8
    COMBOBOX        1303, 33, 134, 55, 79, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Texturing", IDC_STATIC, 99, 7, 166, 148
    LTEXT           "Name:", IDC_STATIC, 106, 17, 22, 8
    EDITTEXT        1033, 106, 29, 144, 12, ES_AUTOHSCROLL
    EDITTEXT        1195, 107, 48, 45, 12, ES_AUTOHSCROLL
    CONTROL         "Spin2", 1248, "msctls_updown32", 0x50000034, 141, 48, 11, 14
    LTEXT           "Horizontal shift", IDC_STATIC, 157, 51, 65, 8
    EDITTEXT        1196, 107, 64, 45, 12, ES_AUTOHSCROLL
    CONTROL         "Spin2", 1251, "msctls_updown32", 0x50000034, 141, 64, 11, 14
    LTEXT           "Vertical shift", IDC_STATIC, 157, 66, 65, 8
    EDITTEXT        1211, 107, 81, 45, 12, ES_AUTOHSCROLL
    CONTROL         "Spin2", 1257, "msctls_updown32", 0x50000034, 141, 81, 11, 14
    LTEXT           "Horizontal stretch", IDC_STATIC, 157, 83, 65, 8
    EDITTEXT        1213, 107, 98, 45, 12, ES_AUTOHSCROLL
    CONTROL         "Spin2", 1254, "msctls_updown32", 0x50000034, 141, 98, 11, 14
    LTEXT           "Vertical stretch", IDC_STATIC, 157, 100, 65, 8
    EDITTEXT        1217, 107, 115, 45, 12, ES_AUTOHSCROLL
    CONTROL         "Spin2", 1259, "msctls_updown32", 0x50000034, 141, 114, 11, 14
    LTEXT           "Rotate", IDC_STATIC, 157, 117, 30, 8
    PUSHBUTTON      "CAP", 1282, 109, 134, 32, 13
    PUSHBUTTON      "Set...", 1283, 148, 134, 32, 13
    PUSHBUTTON      "Natural", 1284, 185, 134, 32, 13
    PUSHBUTTON      "Fit", 1286, 225, 134, 32, 13

    PUSHBUTTON      "Apply", 3, 184, 159, 38, 12
    DEFPUSHBUTTON   "Done", IDOK, 227, 159, 38, 12
END

// CTextureLayout "Patch texture layout" (PE resource 0x9F = 159 = IDD_PATCH_TEXTURE_LAYOUT),
// the modal opened by the Patch Inspector's "Set..." button (sub_459860 ctor / sub_436980).
// Enter a texture x/y scale + pick a layout mode -> Patch_SetTexturing(x, y, mode).  Extracted
// faithfully from the image.  Modes: 2D distance -> 0 (natural), 3D distance -> 1 (arc-length),
// emulates curves -> 2 (grid).
IDD_PATCH_TEXTURE_LAYOUT DIALOGEX 0, 0, 186, 117
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Patch texture layout"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 141, 7, 38, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 141, 24, 38, 14
    LTEXT           "Texture will be fit across the patch based on the x and y values given. Values of 1x1 will ""fit"" the texture. 2x2 will repeat it twice, etc.", IDC_STATIC, 7, 7, 122, 36
    LTEXT           "Texture x:", IDC_STATIC, 7, 48, 32, 8
    EDITTEXT        1089, 42, 46, 36, 12, ES_AUTOHSCROLL
    CONTROL         "", 1453, "msctls_updown32", 0x50020036, 95, 45, 11, 14
    LTEXT           "Texture y:", IDC_STATIC, 7, 64, 32, 8
    EDITTEXT        1142, 42, 62, 36, 12, ES_AUTOHSCROLL
    CONTROL         "", 1455, "msctls_updown32", 0x50020036, 95, 60, 11, 14
    CONTROL         "Terrain uses 2D distance (good for ground)", 1449, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 7, 79, 151, 10
    CONTROL         "Terrain uses 3d distance (good for curvy walls)", 1475, "Button", BS_AUTORADIOBUTTON, 7, 89, 162, 10
    CONTROL         "Terrain emulates curves (backwards compatibility)", 1476, "Button", BS_AUTORADIOBUTTON, 7, 99, 172, 10
END

// CCapDialog "Cap" (PE resource 0xA1 = 161 = IDD_CAP), the modal opened by Curve→Cap
// (CMainFrame::OnCapCurrentCurve → Patch_CapCurrent 0x43AA20) when the selected patch has no
// closed seam edge.  The binary's DoDataExchange (0x40A900) is a single DDX_Radio bound to the
// radio group starting at control id 1285 (member m_nType @ +0x74): index 0=Bevel, 1=Endcap,
// 2=Inverted Bevel, 3=Inverted Endcap → Patch_CapSpecial(def, m_nType, 0/1).  Template
// (rects/style/ids) extracted verbatim from CoD4Radiant.exe RT_DIALOG #161.  The four decorative
// cap-shape preview icons (binary icon ordinals 0xA5/0xA6/0xA3/0xA2, id -1) are not extracted, so
// they use IDI_RADIANT placeholders — cosmetic only; the radio ids are the load-bearing part.
IDD_CAP DIALOGEX 0, 0, 171, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cap"
FONT 8, "MS Sans Serif", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 123, 7, 41, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 123, 25, 41, 14
    CONTROL         "Bevel", 1285, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 31, 10, 50, 10
    CONTROL         "Endcap", 1287, "Button", BS_AUTORADIOBUTTON, 31, 28, 50, 10
    CONTROL         "Inverted Bevel", 1289, "Button", BS_AUTORADIOBUTTON, 31, 47, 68, 10
    CONTROL         "Inverted Endcap", 1291, "Button", BS_AUTORADIOBUTTON, 31, 65, 75, 10
    ICON            IDI_RADIANT, IDC_STATIC, 7, 7, 18, 15
    ICON            IDI_RADIANT, IDC_STATIC, 7, 44, 18, 15
    ICON            IDI_RADIANT, IDC_STATIC, 7, 26, 18, 15
    ICON            IDI_RADIANT, IDC_STATIC, 7, 63, 18, 15
END

// CDialogThick "Thicken Patch" (PE resource 0xA4 = 164 = IDD_THICKEN_PATCH), opened by
// Curve->Thicken (CMainFrame::OnCurveThicken 0x42B0D0, cmd 32904).  DoDataExchange (0x40C060):
// DDX_Check 1288 (member m_seam @+0x74, "Seams" checkbox) + DDX_Text 1290 (m_amount @+0x78, edit).
// Template (rects/style/ids/text) extracted verbatim from CoD4Radiant.exe RT_DIALOG #164; the
// IW3x font "Roboto Slab Light" is normalized back to stock "MS Sans Serif" per the IW3X caveat
// (matches the sibling hand-built dialogs).  [2026-07-01: this template was missing, so
// CDialogThick::DoModal returned -1 and Curve->Thicken silently no-op'd.]
IDD_THICKEN_PATCH DIALOGEX 0, 0, 204, 63
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Thicken Patch"
FONT 8, "MS Sans Serif", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 158, 7, 39, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 158, 24, 39, 14
    LTEXT           "This produces a func_grouped set of patches that contains the original patch along with the 'thick' patch and an optional set of seam patches. ", IDC_STATIC, 7, 7, 145, 33
    EDITTEXT        1290, 38, 42, 26, 12, ES_AUTOHSCROLL
    LTEXT           "Amount:", IDC_STATIC, 7, 44, 27, 8
    CONTROL         "Seams", 1288, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 74, 43, 37, 10
END

