// Entity-display-mode popup (RT_MENU 160, extracted from CoD4Radiant.exe).  OnShowEntities
// (toolbar 32915) loads this via HandlePopup and TrackPopupMenu's submenu 0.  Each item sets
// g_PrefsDlg->m_nEntityShowState and re-checks the matching main-menu item (SetEntityCheck).
IDR_ENTITYPOPUP160 MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Bounding box",        32909
        MENUITEM "Wireframe",           32916
        MENUITEM "Selected Wireframe",  32911
        MENUITEM "Selected Skinned",    32912
        MENUITEM "Skinned",             32913
        MENUITEM "Skinned and Boxed",   32914
    END
END

// The two remaining HandlePopup targets (CMainFrame::OnPopupRenderMethod 0x4263E0 pushes
// 0x7C = 124, OnPopupSelection 0x4263F0 pushes 0x7D = 125).  Both templates extracted
// verbatim from the PE MENU resources; every id already has a handler on CMainFrame.
IDR_POPUP_RENDER_METH MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Wireframe",                   32990
        MENUITEM "&Fullbright",                  32991
        MENUITEM "&Normal-based Fake Lighting",  32992
        MENUITEM "&View-based Fake Lighting",    32993
    END
END

IDR_POPUP_SELECTION MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Select Complete &Tall",  32984
        MENUITEM "Select &Partial Tall",   32983
        MENUITEM "Select T&ouching",       32986
        MENUITEM "Select &Inside",         33008
        MENUITEM "Select T&argetname",     33132
    END
END

