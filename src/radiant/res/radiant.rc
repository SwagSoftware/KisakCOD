// KISAK_RADIANT (P6) — minimal Preferences dialog. The binary's full CPrefsDlg
// template (IDD 127, dozens of controls) was not reconstructed into this .rc; this
// small template backs Edit->Preferences with the load-bearing toggles (snap, light
// preview, sun preview, camera mouse-wheel). CPrefsDlg (prefs.cpp) binds these via
// DDX and persists them with Prefs_SavePrefs on OK. Full faithful template = parked.
IDD_RADIANT_PREFS_MINI DIALOGEX 0, 0, 248, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CoD4Radiant Preferences"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Editor preferences", IDC_STATIC, 7, 7, 234, 92
    CONTROL         "Don't clamp plane points (disable grid snap)", IDC_DON_T_CLAMP_PLANE_POINTS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 22, 215, 12
    CONTROL         "Enable light preview", IDC_RAD_LIGHT_PREVIEW,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 38, 215, 12
    CONTROL         "Preview sun light (sun shading in camera)", IDC_RAD_SUN_PREVIEW,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 54, 215, 12
    CONTROL         "Use mouse wheel in camera window", IDC_USE_MOUSE_WHEEL_IN_CAMERA_WINDOW,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 70, 215, 12
    DEFPUSHBUTTON   "OK", IDOK, 130, 110, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 188, 110, 52, 15
END

// Full CoD4Radiant Preferences (RT_DIALOG template 127, IW3xRadiant.exe). The IW3x
